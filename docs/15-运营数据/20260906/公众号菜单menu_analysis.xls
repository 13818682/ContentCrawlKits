<html xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office"xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head>    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">    <!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name></x:Name><x:WorksheetOptions><x:Selected/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]-->    <style type="text/css">        .td        {            width: 120px;        }        .gdtjContainer .tb tr        {            text-align: center;            vertical-align: middle;        }        .gdtjContainer .tb th        {            border-left: 0.5pt solid #000;            border-bottom: 0.5pt solid #000;            text-align: center;            font-weight: normal;            font-size: 10pt;            middle: ;;height:30px;}        .gdtjContainer .header th        {            font-size: 12pt;        }        .gdtjContainer .tb tr th.noleftborder        {            border-left: none;        }        .gdtjContainer .tb tr th.rightborder        {            border-right: 0.5pt solid #000;        }    </style></head><body>    <div class="gdtjContainer">        <table class="tb" cellspacing="0" cellpadding="0" border="0">            <colgroup>                <col class="td" />                <col class="td" />                <col class="td" />                <col class="td" />            </colgroup>            <tr style="height: 40px">                <th style="font-size: 16pt; font-family: 宋体; border: none;" colspan="6">                    菜单分析（2026-08-07至2026-09-05）                </th>            </tr>            <tr class="header">                <th rowspan="2">版本</th>                <th rowspan="2">一级菜单</th>                <th rowspan="2">二级菜单</th>                <th rowspan="2">菜单点击次数</th>                <th rowspan="2">菜单点击人数</th>                <th rowspan="2">人均点击次数</th>            </tr>            <tr>            </tr>                                            </table>    </div></body></html>