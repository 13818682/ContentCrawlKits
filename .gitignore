# 机器相关 / 密钥（勿提交）
.claude/settings.local.json
.env
.env.*

# 备份产物
迁移备份/
backup/

# 视频/音轨：剪映等工具可再生成的发布产物，不入 git、不做本地备份
*.mp4
*.mp3
*.mov
*.avi
*.mkv

# 脚本输出物（可由 scripts/ 重新生成）
scripts/output/

# 发布用 Word 稿（外部工具由 md 转换，可由 md 再生成，不入 git）
*.docx

# Python 缓存
__pycache__/
*.pyc

# 临时文件
*.tmp
_TMP_*
~$*
*.bak

# 系统
Thumbs.db
.DS_Store
desktop.ini
